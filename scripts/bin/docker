#!/usr/bin/env bash
# Docker CLI shim for Apple Container + container-compose.
# Prefer this over Docker Desktop when present early on PATH.
# macOS ships bash 3.2; empty "${arr[@]}" under `set -u` aborts the script.
set -eo pipefail

# REAL_DOCKER, when set to an executable, wins. Otherwise real_docker_bin
# searches. Do not default to /usr/local/bin/docker: Ubuntu GitHub Actions
# installs the engine at /usr/bin/docker.
CONTAINER_BIN="${CONTAINER_BIN:-container}"
SOCKTAINER_SOCK="${HOME}/.socktainer/container.sock"
GOCKER_SOCK="${HOME}/.gocker/gocker.sock"
# CI / local diagnostics: every invocation arcium makes through this shim.
DOCKER_SHIM_LOG="${DOCKER_SHIM_LOG:-${TMPDIR:-/tmp}/docker-shim.log}"
{
  printf '%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ) docker"
  printf ' %q' "$@"
  printf '\n'
} >>"${DOCKER_SHIM_LOG}" 2>/dev/null || true

# True when `candidate` is this shim or the installed Apple Container docker shim.
is_docker_shim() {
  local candidate="$1"
  [[ -n "$candidate" && -f "$candidate" && -x "$candidate" ]] || return 1
  local self_dir resolved
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  resolved="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
  [[ "$resolved" == "$self_dir/docker" ]] && return 0
  [[ "$resolved" == "${HOME}/.local/bin/docker" ]] && return 0
  if head -n 8 "$candidate" 2>/dev/null | grep -q 'Apple Container'; then
    return 0
  fi
  return 1
}

# Engine binary that is not this shim. Linux (GitHub Actions) is /usr/bin/docker.
real_docker_bin() {
  if [[ -n "${REAL_DOCKER:-}" && -x "${REAL_DOCKER}" ]] && ! is_docker_shim "${REAL_DOCKER}"; then
    printf '%s\n' "${REAL_DOCKER}"
    return 0
  fi
  local self_dir candidate path_dir old_ifs
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  local -a candidates
  if [[ "$(uname -s)" == "Darwin" ]]; then
    candidates=(/usr/local/bin/docker /opt/homebrew/bin/docker /usr/bin/docker)
  else
    candidates=(/usr/bin/docker /usr/local/bin/docker)
  fi
  for candidate in "${candidates[@]}"; do
    if [[ -x "$candidate" ]] && ! is_docker_shim "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  old_ifs="$IFS"
  IFS=':'
  for path_dir in $PATH; do
    IFS="$old_ifs"
    if [[ -z "$path_dir" || "$path_dir" == "$self_dir" ]]; then
      continue
    fi
    if [[ -x "${path_dir}/docker" ]] && ! is_docker_shim "${path_dir}/docker"; then
      printf '%s\n' "${path_dir}/docker"
      return 0
    fi
  done
  IFS="$old_ifs"
  echo "docker shim: Docker Engine binary not found" >&2
  return 127
}

# Apple Container is a macOS hypervisor. Linux hosts and the GitHub Actions
# Arcium job use Docker Engine. ARCIUM_USE_APPLE_CONTAINER=0 is the same
# choice on a Mac that has Docker installed.
have_apple_container() {
  [[ "$(uname -s)" == "Darwin" ]] || return 1
  [[ "${ARCIUM_USE_APPLE_CONTAINER:-}" == "0" ]] && return 1
  [[ "${GITHUB_ACTIONS:-}" == "true" ]] && return 1
  command -v "$CONTAINER_BIN" >/dev/null 2>&1 \
    && "$CONTAINER_BIN" system status 2>/dev/null | grep -qi 'status[[:space:]]\+running'
}

# container-compose wants: compose <subcommand> [flags…]
# docker compose accepts global flags before the subcommand; rewrite them.
run_apple_compose() {
  local -a global_flags=()
  local -a rest=()
  local sub=""
  local skip_next=0
  local detach=0
  local arg

  for arg in "$@"; do
    if [[ "$skip_next" -eq 1 ]]; then
      global_flags+=("$arg")
      skip_next=0
      continue
    fi
    if [[ -z "$sub" ]]; then
      case "$arg" in
        -f|--file|-p|--project-name|--env-file|--profile)
          global_flags+=("$arg")
          skip_next=1
          ;;
        -f=*|--file=*|-p=*|--project-name=*|--env-file=*|--profile=*)
          global_flags+=("$arg")
          ;;
        -d|--detach)
          detach=1
          ;;
        --remove-orphans|--force-recreate|--no-deps|--abort-on-container-exit|--quiet-pull)
          ;;
        up|down|ps|logs|config|exec|pull|stop|start|restart|kill|update)
          sub="$arg"
          ;;
        *)
          rest+=("$arg")
          ;;
      esac
      continue
    fi

    case "$arg" in
      -d|--detach)
        detach=1
        ;;
      --remove-orphans|--force-recreate|--no-deps|--abort-on-container-exit|--quiet-pull)
        ;;
      --wait-timeout|--timeout|--scale|--exit-code-from)
        skip_next=1
        ;;
      --wait-timeout=*|--timeout=*|--scale=*|--exit-code-from=*)
        ;;
      *)
        rest+=("$arg")
        ;;
    esac
  done

  if [[ -z "$sub" ]]; then
    sub="up"
  fi

  # Apple `container compose up` has hung indefinitely on the Arcium stack in CI
  # (empty log, zero containers) even after stripping IPAM/subnet. Busybox smoke
  # tests prove `container run` works, so drive Arcium services that way.
  if [[ "$sub" == "up" ]]; then
    local up_log="${DOCKER_SHIM_LOG%.log}-compose-up.log"
    local compose_file=""
    local i=0
    while [[ $i -lt ${#global_flags[@]} ]]; do
      case "${global_flags[$i]}" in
        -f|--file)
          compose_file="${global_flags[$((i + 1))]:-}"
          break
          ;;
        -f=*|--file=*)
          compose_file="${global_flags[$i]#*=}"
          break
          ;;
      esac
      i=$((i + 1))
    done
    {
      printf '%s compose up' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      if [[ ${#global_flags[@]} -gt 0 ]]; then printf ' %q' "${global_flags[@]}"; fi
      if [[ ${#rest[@]} -gt 0 ]]; then printf ' %q' "${rest[@]}"; fi
      printf ' file=%q\n' "${compose_file}"
    } >>"${DOCKER_SHIM_LOG}" 2>/dev/null || true
    : >"$up_log"
    if [[ -z "$compose_file" || ! -f "$compose_file" ]]; then
      # arcium invokes us from rust/casino; resolve relative -f paths.
      local cand
      for cand in \
        "${compose_file}" \
        "artifacts/docker-compose-arx-env.yml" \
        "rust/casino/artifacts/docker-compose-arx-env.yml"
      do
        if [[ -n "$cand" && -f "$cand" ]]; then
          compose_file="$(cd "$(dirname "$cand")" && pwd)/$(basename "$cand")"
          break
        fi
      done
    fi
    if [[ -n "$compose_file" && -f "$compose_file" ]] \
      && grep -q 'arcium-trusted-dealer:' "$compose_file" \
      && command -v python3 >/dev/null 2>&1
    then
      set +e
      echo "docker shim: starting arcium via container run from ${compose_file}" >>"$up_log"
      python3 - "$CONTAINER_BIN" "$compose_file" "artifacts-arx_network" <<'PY' >>"$up_log" 2>&1
import os, re, subprocess, sys, time

container, compose_path, network = sys.argv[1], sys.argv[2], sys.argv[3]
mem = os.environ.get("ARCIUM_APPLE_MEM_LIMIT", "1536m").strip() or "1536m"
text = open(compose_path, encoding="utf-8").read()
# Keep primary cluster only — matches test/e2e/arcium-docker.ts Apple filter.
keep = ["arcium-trusted-dealer", "arx-node-0", "arx-node-1"]
services = {}
current = None
in_env = False
for raw in text.splitlines():
    m = re.match(r"^  ([a-z0-9-]+):\s*$", raw)
    if m and not raw.startswith("   "):
        name = m.group(1)
        current = name if name in keep else None
        in_env = False
        if current:
            services[current] = {"image": None, "platform": "linux/amd64", "env": {}, "volumes": [], "ports": []}
        continue
    if not current:
        continue
    if re.match(r"^\s+environment:\s*$", raw):
        in_env = True
        continue
    if re.match(r"^\s+(image|platform|restart|volumes|ports|networks|depends_on|mem_limit):", raw):
        in_env = False
    if m := re.match(r'^\s+image:\s*"?([^"]+)"?\s*$', raw):
        services[current]["image"] = m.group(1)
    elif m := re.match(r"^\s+platform:\s*(\S+)\s*$", raw):
        services[current]["platform"] = m.group(1)
    elif in_env and (m := re.match(r"^\s+([A-Z0-9_]+):\s*(.+?)\s*$", raw)):
        services[current]["env"][m.group(1)] = m.group(2).strip().strip('"')
    elif m := re.match(r'^\s+source:\s*(.+?)\s*$', raw):
        services[current]["_src"] = m.group(1)
    elif m := re.match(r'^\s+target:\s*(.+?)\s*$', raw):
        src = services[current].pop("_src", None)
        if src:
            services[current]["volumes"].append((src, m.group(1)))
    elif (m := re.match(r'^\s+-\s*"([^"]+)"\s*$', raw)) and ":" in m.group(1):
        services[current]["ports"].append(m.group(1))

# Ensure the shared network exists (created earlier by ensureAppleArxNetwork).
subprocess.run([container, "network", "inspect", network], check=False, capture_output=True)

order = [s for s in keep if s in services]
if not order:
    print("docker shim: no arcium services found in compose file", file=sys.stderr)
    sys.exit(1)

for name in order:
    svc = services[name]
    cname = f"artifacts-{name}"
    subprocess.run([container, "stop", cname], check=False, capture_output=True)
    subprocess.run([container, "delete", "--force", cname], check=False, capture_output=True)
    cmd = [
        container, "run", "-d", "--name", cname,
        "--platform", svc["platform"],
        "--memory", mem,
        "--network", network,
    ]
    for k, v in svc["env"].items():
        cmd += ["--env", f"{k}={v}"]
    for src, tgt in svc["volumes"]:
        cmd += ["--volume", f"{src}:{tgt}"]
    for p in svc["ports"]:
        # "127.0.0.1:9091:9091" → publish 9091
        parts = p.split(":")
        cmd += ["--publish", parts[-2] + ":" + parts[-1] if len(parts) >= 2 else p]
    if not svc["image"]:
        print(f"docker shim: service {name} missing image", file=sys.stderr)
        sys.exit(1)
    cmd.append(svc["image"])
    print("+", " ".join(cmd), flush=True)
    r = subprocess.run(cmd, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode != 0:
        print(f"docker shim: container run failed for {name} (exit {r.returncode})", file=sys.stderr)
        sys.exit(r.returncode)
    time.sleep(2)

listed = subprocess.run([container, "list", "--format", "json"], capture_output=True, text=True)
print(listed.stdout)
if "arcium-trusted-dealer" not in listed.stdout and "arx-node" not in listed.stdout:
    print("docker shim: containers did not appear after run", file=sys.stderr)
    sys.exit(1)
print("docker shim: arcium containers started via container run", flush=True)
PY
      local up_status=$?
      set -e
      cat "$up_log" >>"${DOCKER_SHIM_LOG}" 2>/dev/null || true
      cat "$up_log" >&2 || true
      {
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) compose up exit=${up_status} (container-run path)"
        "$CONTAINER_BIN" list --format json 2>/dev/null || echo '[]'
      } >>"${DOCKER_SHIM_LOG}" 2>/dev/null || true
      if [[ "$up_status" -ne 0 ]]; then
        exit "$up_status"
      fi
      cleanup_compose_up() {
        for n in artifacts-arcium-trusted-dealer artifacts-arx-node-0 artifacts-arx-node-1; do
          "$CONTAINER_BIN" stop "$n" >/dev/null 2>&1 || true
          "$CONTAINER_BIN" delete --force "$n" >/dev/null 2>&1 || true
        done
        exit 0
      }
      trap cleanup_compose_up TERM INT HUP
      local misses=0
      while true; do
        if "$CONTAINER_BIN" list --format json 2>/dev/null | grep -Eq 'arcium-trusted-dealer|arx-node'; then
          misses=0
        else
          misses=$((misses + 1))
          if [[ "$misses" -ge 3 ]]; then
            exit 1
          fi
        fi
        sleep 2
      done
    fi
    echo "docker shim: refusing Apple container compose up without arcium compose file" >&2
    exit 1
  fi

  if [[ ${#global_flags[@]} -gt 0 || ${#rest[@]} -gt 0 ]]; then
    exec "$CONTAINER_BIN" compose "$sub" ${global_flags[@]+"${global_flags[@]}"} ${rest[@]+"${rest[@]}"}
  fi
  exec "$CONTAINER_BIN" compose "$sub"
}

run_via_bridge() {
  # Apple sockets only when this process is actually on Apple Container.
  # Pointing DOCKER_HOST at them on Linux sends the Arcium job at a shim
  # that is not running.
  if have_apple_container; then
    if [[ -S "$GOCKER_SOCK" ]]; then
      export DOCKER_HOST="unix://${GOCKER_SOCK}"
    elif [[ -S "$SOCKTAINER_SOCK" ]]; then
      export DOCKER_HOST="unix://${SOCKTAINER_SOCK}"
    fi
  fi
  local bin
  bin="$(real_docker_bin)" || exit $?
  exec "$bin" "$@"
}

fake_info() {
  cat <<'INFOEOF'
Client:
 Version:    28.3.2 (apple-container-shim)
 Context:    apple-container
Server:
 Containers: 0
  Running: 0
  Paused: 0
  Stopped: 0
 Images: 0
 Server Version: apple-container
 Storage Driver: apple
 Operating System: macOS (Apple Container)
 OSType: linux
 Architecture: aarch64
 CPUs: 4
 Total Memory: 8GiB
 Name: apple-container
 Docker Root Dir: /var/lib/apple-container
INFOEOF
}

fake_version() {
  cat <<'VEREOF'
Client: Docker Engine - Community
 Version:           28.3.2
 API version:       1.51
 Go version:        go1.24.0
 OS/Arch:           darwin/arm64
 Context:           apple-container

Server: Apple Container
 Engine:
  Version:          1.2.0
  API version:      1.51 (minimum version 1.32)
  OSType:           linux
  Architecture:     aarch64
VEREOF
}

fake_compose_version() {
  echo "Docker Compose version v2.39.1 (apple-container-compose)"
}

# Arcium runs `docker compose -f … up` and waits on that process only as a
# supervisor. Attached `up` has no TTY on GitHub Actions and never returns, so
# the CLI never reaches the validator and the tests never start. Detach the
# stack, then stay alive until that supervisor is signalled.
run_engine_compose() {
  local arg sub="" skip_next=0 has_detach=0
  local -a global=()
  for arg in "$@"; do
    if [[ "$skip_next" -eq 1 ]]; then
      global+=("$arg")
      skip_next=0
      continue
    fi
    if [[ -z "$sub" ]]; then
      case "$arg" in
        -f|--file|-p|--project-name|--env-file|--profile)
          global+=("$arg")
          skip_next=1
          ;;
        -f=*|--file=*|-p=*|--project-name=*|--env-file=*|--profile=*)
          global+=("$arg")
          ;;
        up|down|ps|logs|config|exec|pull|stop|start|restart|kill|version|--version)
          sub="$arg"
          ;;
      esac
      continue
    fi
    case "$arg" in
      -d|--detach) has_detach=1 ;;
    esac
  done

  if [[ "$sub" != "up" || "$has_detach" -eq 1 ]]; then
    run_via_bridge compose "$@"
  fi

  local bin
  bin="$(real_docker_bin)" || exit $?
  echo "docker shim: backgrounding Arcium with docker compose up -d" >&2
  set +e
  "$bin" compose "${global[@]}" up -d < /dev/null
  local up_status=$?
  set -e
  if [[ "$up_status" -ne 0 ]]; then
    exit "$up_status"
  fi

  cleanup_engine_compose() {
    "$bin" compose "${global[@]}" down --remove-orphans >/dev/null 2>&1 || true
    exit 0
  }
  trap cleanup_engine_compose TERM INT HUP
  while true; do
    sleep 2
  done
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help)
    if have_apple_container; then
      echo "Docker shim → Apple Container / container-compose"
      echo "Usage: docker compose … | docker info | docker version | docker rm …"
      exit 0
    fi
    run_via_bridge "${cmd:-}" "$@"
    ;;
  compose)
    # Apple Container has no Compose until the container-compose plugin is installed.
    # The plugin answers `--version`; bare `version` looks for a compose file.
    # Arcium accepts a Docker-shaped version line, then runs `compose up`.
    if have_apple_container && "$CONTAINER_BIN" compose --version >/dev/null 2>&1; then
      if [[ "${1:-}" == "version" || "${1:-}" == "--version" ]]; then
        if [[ "${2:-}" == "--short" || "${1:-}" == "--short" ]]; then
          echo "2.39.1"
        else
          fake_compose_version
        fi
        exit 0
      fi
      run_apple_compose "$@"
    fi
    run_engine_compose "$@"
    ;;
  info)
    if have_apple_container; then
      fake_info
      exit 0
    fi
    run_via_bridge info "$@"
    ;;
  version|--version|-v)
    if have_apple_container; then
      if [[ "${1:-}" == "-f" || "${1:-}" == "--format" ]]; then
        echo "28.3.2"
        exit 0
      fi
      fake_version
      exit 0
    fi
    run_via_bridge "$cmd" "$@"
    ;;
  rm|remove)
    if have_apple_container; then
      force=0
      names=()
      for arg in "$@"; do
        case "$arg" in
          -f|--force) force=1 ;;
          -*) ;;
          *) names+=("$arg") ;;
        esac
      done
      for name in "${names[@]:-}"; do
        if [[ "$force" -eq 1 ]]; then
          "$CONTAINER_BIN" stop "$name" >/dev/null 2>&1 || true
        fi
        "$CONTAINER_BIN" rm "$name" >/dev/null 2>&1 || true
      done
      exit 0
    fi
    run_via_bridge rm "$@"
    ;;
  ps)
    if have_apple_container; then
      "$CONTAINER_BIN" ls "$@"
      exit $?
    fi
    run_via_bridge ps "$@"
    ;;
  pull)
    if have_apple_container; then
      platform=""
      image=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --platform) platform="$2"; shift 2 ;;
          --platform=*) platform="${1#*=}"; shift ;;
          -*) shift ;;
          *) image="$1"; shift ;;
        esac
      done
      if [[ -n "$platform" ]]; then
        exec "$CONTAINER_BIN" image pull --platform "$platform" "$image"
      fi
      exec "$CONTAINER_BIN" image pull "$image"
    fi
    run_via_bridge pull "$@"
    ;;
  inspect)
    if have_apple_container; then
      # Convert Apple Container inspect → Docker-compatible JSON (IPAddress etc.).
      python3 - "$@" <<'PY'
import json, subprocess, sys

names = [a for a in sys.argv[1:] if not a.startswith("-")]
fmt = None
args = sys.argv[1:]
i = 0
while i < len(args):
    if args[i] in ("-f", "--format") and i + 1 < len(args):
        fmt = args[i + 1]
        i += 2
        continue
    if args[i].startswith("--format="):
        fmt = args[i].split("=", 1)[1]
        i += 1
        continue
    i += 1

if not names:
    print("docker inspect requires at least one container", file=sys.stderr)
    sys.exit(1)

raw = subprocess.check_output(["container", "inspect", *names], text=True)
apple = json.loads(raw)
if not isinstance(apple, list):
    apple = [apple]

out = []
for obj in apple:
    cfg = obj.get("configuration") or {}
    status = obj.get("status") or {}
    cid = obj.get("id") or cfg.get("id") or ""
    state = status.get("state") or "unknown"
    running = state == "running"
    nets = status.get("networks") or []
    ip = ""
    gw = ""
    mac = ""
    networks = {}
    for n in nets:
        ipv4 = (n.get("ipv4Address") or "").split("/")[0]
        if not ip and ipv4:
            ip = ipv4
            gw = n.get("ipv4Gateway") or ""
            mac = n.get("macAddress") or ""
        net_name = n.get("network") or "bridge"
        networks[net_name] = {
            "IPAMConfig": None,
            "Links": None,
            "Aliases": [n.get("hostname") or cid] if n.get("hostname") else [],
            "NetworkID": net_name,
            "EndpointID": "",
            "Gateway": n.get("ipv4Gateway") or "",
            "IPAddress": ipv4,
            "IPPrefixLen": int((n.get("ipv4Address") or "0/16").split("/")[-1] or 16),
            "IPv6Gateway": "",
            "GlobalIPv6Address": (n.get("ipv6Address") or "").split("/")[0],
            "GlobalIPv6PrefixLen": 0,
            "MacAddress": n.get("macAddress") or "",
            "DriverOpts": None,
        }
    image = ""
    img = cfg.get("image") or {}
    if isinstance(img, dict):
        image = img.get("reference") or ""
    out.append({
        "Id": cid,
        "Name": f"/{cid}",
        "Config": {"Image": image, "Hostname": (nets[0].get("hostname") if nets else cid), "Labels": cfg.get("labels") or {}},
        "Image": image,
        "State": {
            "Status": state,
            "Running": running,
            "Paused": False,
            "Restarting": False,
            "OOMKilled": False,
            "Dead": False,
            "Pid": 1 if running else 0,
            "ExitCode": 0,
            "Error": "",
            "StartedAt": status.get("startedDate") or "",
            "FinishedAt": "",
        },
        "NetworkSettings": {
            "Bridge": "",
            "SandboxID": "",
            "Ports": {},
            "Gateway": gw,
            "IPAddress": ip,
            "IPPrefixLen": 16,
            "MacAddress": mac,
            "Networks": networks,
        },
    })

if fmt:
    # Minimal support for common templates arcium might use.
    if "IPAddress" in fmt and len(out) == 1:
        print(out[0]["NetworkSettings"]["IPAddress"])
    else:
        print(json.dumps(out))
else:
    json.dump(out, sys.stdout, indent=4)
    print()
PY
      exit $?
    fi
    run_via_bridge inspect "$@"
    ;;
  *)
    run_via_bridge "$cmd" "$@"
    ;;
esac
