// Uses random linear combination instead of powers of 2
// to make collisions computationally infeasible.
//
// Each input is a BN254 field element (up to 254 bits).
// The circuit extracts and combines low/high bits before hashing.
//
// Structure: [11 players][4 cards each][4 BN254 values per card]
//
// SAFETY: After extraction:
//   - Each value < 2^129 (low + 2*high)
//   - Coefficients < 2^100
//   - Max term: (2^129 - 1) * (2^100 - 1) < 2^229
//   - Max sum (176 terms): 176 * 2^229 < 2^239
//   - 2^239 < BN254 prime (≈2^254) and < Ed25519 prime (≈2^255)
//   - No wraparound in either field → identical results!

template PolynomialHash(nPlayers, nCards) {
  var nOthers = nPlayers - 1;

  signal input in[nOthers][nCards][4];
  signal input nActualPlayers;

  signal recipientActive[nOthers];
  signal term[nOthers][nCards][4];

  signal output out;

  component nBits;
  component geMin;
  component ltMax;
  component recipientActiveLt[nOthers];
  component extractors[nOthers][nCards][4];

  // Range-check nActualPlayers ∈ [2, nPlayers]
  nBits = Num2Bits(4);
  nBits.in <== nActualPlayers;

  geMin = ConstrainGt(4, 1);
  geMin.in <== nActualPlayers;

  ltMax = ConstrainLt(4, nPlayers + 1);
  ltMax.in <== nActualPlayers;

  for (var i = 0; i < nOthers; i++) {
    // active iff i < nActualPlayers - 1  ⇔  (i+1) < nActualPlayers
    recipientActiveLt[i] = LessThan(4);
    recipientActiveLt[i].in[0] <== i + 1;
    recipientActiveLt[i].in[1] <== nActualPlayers;
    recipientActive[i] <== recipientActiveLt[i].out;
  }

  var hash = 0;
  var idx = 0;

  for (var i = 0; i < nOthers; i++) {
    for (var j = 0; j < nCards; j++) {
      for (var k = 0; k < 4; k++) {
        extractors[i][j][k] = parallel ExtractAndCombine();
        extractors[i][j][k].in <== in[i][j][k];
        term[i][j][k] <== extractors[i][j][k].out * recipientActive[i];
        hash = hash + term[i][j][k] * coeffs(idx);
        idx++;
      }
    }
  }

  out <== hash;
}

// Check for nActualPlayers among sharing keys (used for Polynomial hash)
template ActualPlayersCheck(nOthers) {
  signal input publicKeys[nOthers][2];
  signal input nActualPlayers;

  signal yMinus1[nOthers];
  signal isIdentity[nOthers];
  signal active[nOthers];
  signal inactive[nOthers];
  signal nActualMinus1;

  component activeLt[nOthers];
  component isZeroX[nOthers];
  component isZeroY[nOthers];

  // nActualPlayers >= 2 on real share paths; minus-one stays in 4-bit range.
  nActualMinus1 <== nActualPlayers - 1;

  // Recipient slot i is active iff i < nActualPlayers-1 (prover-first others list).
  // Active → not identity; inactive → [0, 1].
  for (var i = 0; i < nOthers; i++) {
    activeLt[i] = LessThan(4);
    activeLt[i].in[0] <== i;
    activeLt[i].in[1] <== nActualMinus1;
    active[i] <== activeLt[i].out;
    inactive[i] <== 1 - active[i];

    isZeroX[i] = IsZero();
    isZeroX[i].in <== publicKeys[i][0];
    yMinus1[i] <== publicKeys[i][1] - 1;
    isZeroY[i] = IsZero();
    isZeroY[i].in <== yMinus1[i];
    isIdentity[i] <== isZeroX[i].out * isZeroY[i].out;

    active[i] * isIdentity[i] === 0;
    inactive[i] * publicKeys[i][0] === 0;
    inactive[i] * yMinus1[i] === 0;
  }
}
