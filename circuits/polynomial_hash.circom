// Extract low 128 bits and high 126 bits from a BN254 field element,
// then combine them as: low + 2*reversed(high).
//
// Canonical decomposition: Num2Bits_strict (AliasCheck) so the 254-bit
// witness cannot be a non-unique / ≥p bit pattern.
//
// Injectivity limits (intentional compression — document for auditors):
//   - Domain: canonical BN254 field elements (strict bit decomposition).
//   - Codomain: out < 2^128 + 2*(2^126 - 1) < 2^129.
//   - fold is NOT injective: many `in` map to the same `out` because 254 bits
//     are folded into <129 bits. Collision resistance of the outer poly hash
//     relies on HASH_COEFFS_900 randomness, not on fold injectivity.
//   - Limb binding: callers must treat each folded limb as one poly term at a
//     fixed coefficient index; do not re-split or reinterpret `out` as bits.
//
// Rebuild note: changing Num2Bits → Num2Bits_strict alters the R1CS; regenerate
// zkeys for every circuit that includes this template before release proving.
template ExtractAndCombine() {
    signal input in;
    
    signal output out;

    component bits;
    component low128;
    component high126;

    // Canonical 254-bit decomposition (rejects alias ≥ p bit patterns).
    bits = Num2Bits_strict();
    bits.in <== in;

    // Recompose low 128 bits (normal order)
    low128 = Bits2Num(128);
    for (var i = 0; i < 128; i++) {
        low128.in[i] <== bits.out[i];
    }

    // Recompose high 126 bits (bits 128..253) in REVERSED order
    // This adds extra non-linearity to the high bits without affecting
    // the low bits that contain the actual card values.
    high126 = Bits2Num(126);
    for (var i = 0; i < 126; i++) {
        high126.in[i] <== bits.out[253 - i];
    }

    // Combine: low + 2*reversed_high
    out <== low128.out + 2 * high126.out;
}

